[Unit]
Description=PSMoveServiceEx Daemon
After=network.target bluetooth.target

[Service]
Type=simple
User=psmovecam
Group=psmovecam
WorkingDirectory=/var/lib/psmove
ExecStart=/usr/bin/PSMoveService
Restart=on-failure
RestartSec=3

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target